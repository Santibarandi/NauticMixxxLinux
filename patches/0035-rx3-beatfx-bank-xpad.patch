+++ b/src/widget/wrx3beatfx.h
@@ -0,0 +1,565 @@
+#pragma once
+
+#include <QHideEvent>
+#include <QFontInfo>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QMouseEvent>
+#include <QMenu>
