+void SoundManagerConfig::useSystemDefaultOutput(const SoundDeviceId& device,
+        const QString& api, mixxx::audio::SampleRate sampleRate) {
+    AudioOutput mainOut(AudioPathType::Main, 0,
+            mixxx::audio::ChannelCount::stereo(), 0);
+    bool mainAlreadyUsesDevice = false;
+    // Keep the channel pair when MASTER already uses this interface.
+    for (auto it = m_outputs.constBegin(); it != m_outputs.constEnd(); ++it) {
+        if (it.key() == device && it->getType() == AudioPathType::Main) {
+            mainOut = it.value();
+            mainAlreadyUsesDevice = m_api == api;
+            break;
+        }
+    }
+    if (m_api != api) {
+        // Device IDs and channels from another host API cannot be reused.
+        clearInputs();
+        clearOutputs();
+    } else {
+        for (auto it = m_outputs.begin(); it != m_outputs.end();) {
+            if (it->getType() == AudioPathType::Main ||
+                    (it.key() == device && it->channelsClash(mainOut))) {
+                it = m_outputs.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+    m_api = api;
+    addOutput(device, mainOut);
+    if (!mainAlreadyUsesDevice && sampleRate.isValid()) {
+        m_sampleRate = sampleRate;
+    }
+}
