+        {[this]() -> QString {return QString("POSITION: %1%").arg(qRound(100*m_previewPosition));},{},[this](int delta){m_previewPosition=qBound(0.0,m_previewPosition+delta*0.01,1.0);m_toolPreview->move(m_previewPosition);}},
