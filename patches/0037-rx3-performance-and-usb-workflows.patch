+        toolAction("PREVIEW SELECTED TRACK",[this]{showPreviewTools();}),
+        toolAction("USB RECORDING",[this]{showRecordingTools();}),
+        toolAction("MIXER / MIC / AUX / BOOTH",[this]{showAudioTools();}),
+        toolAction("SHORTCUT / MY SETTINGS",[this]{closeTools();ControlObject::set(ConfigKey("[RX3Shortcut]","open"),1);ControlObject::set(ConfigKey("[RX3Shortcut]","open"),0);})
+    },[this]{closeTools();});
