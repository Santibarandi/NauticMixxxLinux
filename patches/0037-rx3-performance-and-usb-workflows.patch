 void WTrackTableView::mousePressEvent(QMouseEvent* pEvent) {
+    if (m_rx3Browser && pEvent->button() == Qt::LeftButton) {
+        const auto index = indexAt(pEvent->pos());
+        if (index.isValid() && columnNameOfIndex(index) == "preview") {
+            if (!m_touchPreview) {
+                m_touchPreview = std::make_unique<rx3::TouchPreview>([this](TrackPointer track) {
+                    emit loadTrackToPlayer(track, "[PreviewDeck1]", false);
+                });
+                connect(&PlayerInfo::instance(), &PlayerInfo::trackChanged, this,
+                        [this](const QString& group, TrackPointer track, TrackPointer) {
+                    if (group == "[PreviewDeck1]") m_touchPreview->completed(track);
+                });
+            }
+            auto* model = getTrackModel();
+            const auto rect = visualRect(index).adjusted(6, 0, -6, 0);
+            selectRow(index.row()); m_touchPreviewIndex = index;
+            m_touchPreview->begin(model ? model->getTrack(index) : TrackPointer(),
+                    PlayerInfo::instance().getTrackInfo("[PreviewDeck1]"),
+                    double(pEvent->pos().x() - rect.left()) / qMax(1, rect.width()));
+            pEvent->accept(); return;
+        }
+    }
     DragAndDropHelper::mousePressed(pEvent);
     WLibraryTableView::mousePressEvent(pEvent);
 }
 
+void WTrackTableView::mouseReleaseEvent(QMouseEvent* event) {
+    if (m_touchPreview && m_touchPreview->held() && event->button() == Qt::LeftButton) {
+        m_touchPreview->cancel(); m_touchPreviewIndex = QModelIndex(); event->accept(); return;
+    }
+    WLibraryTableView::mouseReleaseEvent(event);
+}
+
+void WTrackTableView::hideEvent(QHideEvent* event) {
+    if (m_touchPreview) m_touchPreview->cancel();
+    WLibraryTableView::hideEvent(event);
+}
+
 void WTrackTableView::mouseMoveEvent(QMouseEvent* pEvent) {
+    if (m_touchPreview && m_touchPreview->held()) {
+        if (!m_touchPreviewIndex.isValid() || !(pEvent->buttons() & Qt::LeftButton)) {
+            m_touchPreview->cancel();
+        } else {
+            const auto rect = visualRect(m_touchPreviewIndex).adjusted(6, 0, -6, 0);
+            m_touchPreview->move(double(pEvent->pos().x() - rect.left()) / qMax(1, rect.width()));
+        }
+        pEvent->accept(); return;
+    }
