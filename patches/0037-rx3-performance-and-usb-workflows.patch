+        *error = "Invalid or mismatched ANLZ file."; return {};
+    }
+    for (const auto& diagnostic : parsed.diagnostics) if (!diagnostic.startsWith("Unmapped ANLZ section ")) {
+        *error = "Unsupported or malformed ANLZ section: " + diagnostic; return {};
