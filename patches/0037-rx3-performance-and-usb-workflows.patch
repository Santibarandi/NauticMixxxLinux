diff --git a/src/widget/wrx3toolmenu.h b/src/widget/wrx3toolmenu.h
new file mode 100644
--- /dev/null
+++ b/src/widget/wrx3toolmenu.h
@@ -0,0 +1,69 @@
+#pragma once
+
+#include <QLabel>
+#include <QListWidget>
+#include <QPushButton>
+#include <QVBoxLayout>
+#include <functional>
+#include <vector>
+#include <algorithm>
+
+// Every action has the same encoder contract, irrespective of controller:
+// turn selects, press executes/starts editing, turn edits, press finishes.
+// Back exits editing first, then returns one level. Callbacks are copied before
+// invocation because an action may replace its own menu.
+class WRx3ToolMenu : public QWidget {
+  public:
+    struct Action {
+        std::function<QString()> label;
+        std::function<void()> execute;
+        std::function<void(int)> adjust;
+    };
+    explicit WRx3ToolMenu(QWidget* parent) : QWidget(parent) {
+        setObjectName("RX3BrowserTools");
+        setStyleSheet("#RX3BrowserTools {background:#202020;color:white;} #RX3BrowserTools QLabel {color:white;font-family:Arial;font-size:16px;} #RX3BrowserTools QListWidget {background:#202020;color:white;border:0;font-family:Arial;font-size:16px;} #RX3BrowserTools QPushButton {background:#202020;color:white;border:1px solid white;min-height:36px;}");
+        auto* layout=new QVBoxLayout(this);
+        m_title=new QLabel(this);layout->addWidget(m_title);
+        m_list=new QListWidget(this);m_list->setObjectName("RX3ToolsActions");
+        m_list->setStyleSheet("QListWidget::item {min-height:40px;} QListWidget::item:selected {background:#007CE0;color:white;}");
+        layout->addWidget(m_list,1);
+        m_status=new QLabel(this);m_status->setWordWrap(true);layout->addWidget(m_status);
+        auto* back=new QPushButton("BACK",this);layout->addWidget(back);
+        connect(back,&QPushButton::clicked,this,[this]{goBack();});
+        connect(m_list,&QListWidget::itemClicked,this,[this]{enter();});
+    }
+    void showMenu(QString title,std::vector<Action> actions,std::function<void()> back) {
+        m_actions=std::move(actions);m_back=std::move(back);m_editing=false;
+        m_title->setText(std::move(title));m_list->clear();
+        for (const auto& action:m_actions) m_list->addItem(action.label());
+        if (!m_actions.empty()) m_list->setCurrentRow(0);
+        message("Turn to select · Press to open or edit · Hold to go back");
+    }
+    void move(int delta) {
+        const int row=m_list->currentRow();
+        if (row<0) return;
+        if (m_editing) {const auto adjust=m_actions[row].adjust;if(adjust) adjust(delta);refresh();}
+        else m_list->setCurrentRow(std::clamp(row+delta,0,int(m_actions.size())-1));
+    }
+    void enter() {
+        const int row=m_list->currentRow();if (row<0) return;
+        if (m_actions[row].adjust) {
+            m_editing=!m_editing;
+            message(m_editing?"Turn to change · Press to finish":"Value set · Turn to select");
+        } else {const auto execute=m_actions[row].execute;if(execute) execute();}
+        refresh();
+    }
+    void goBack() {
+        if(m_editing) {m_editing=false;message("Value set · Turn to select");return;}
+        const auto back=m_back;if(back) back();
+    }
+    void message(const QString& text) {m_status->setText(text);}
+    void refresh() {for(int i=0;i<int(m_actions.size());++i) if(auto* item=m_list->item(i)) item->setText(m_actions[i].label());}
+  private:
+    QLabel* m_title;
+    QLabel* m_status;
+    QListWidget* m_list;
+    std::vector<Action> m_actions;
+    std::function<void()> m_back;
+    bool m_editing=false;
+};
