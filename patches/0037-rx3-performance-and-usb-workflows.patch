+QList<CuePointer> CueControl::rx3MemoryCues(const TrackPointer& track) const {
+    QList<CuePointer> cues;
+    if (track) for (const auto& cue : track->getCuePoints()) {
+        const auto type = cue->getType();
+        if (type == mixxx::CueType::MemoryCue || type == mixxx::CueType::MemoryLoop || type == mixxx::CueType::ActiveLoop)
+            cues.append(cue);
+    }
+    std::stable_sort(cues.begin(), cues.end(), [](const CuePointer& a, const CuePointer& b) {
+        return a->getPosition() < b->getPosition();
+    });
+    return cues;
+}
+
+void CueControl::rx3MemoryAction(int action) {
+    auto lock = lockMutex(&m_trackMutex);
+    auto track = m_pLoadedTrack;
+    if (!track) return;
+    auto memory = rx3MemoryCues(track);
+    auto selected = m_rx3MemorySelected;
+    const auto position = frameInfo().currentPosition;
+    lock.unlock(); // Track mutations emit cuesUpdated synchronously.
+    if (action < 2) {
+        int index = memory.indexOf(selected);
+        if (index < 0) {
+            index = action == 0 ? -1 : memory.size();
+            for (int i = 0; i < memory.size(); ++i) {
+                if (action == 0 && memory[i]->getPosition() < position) index = i;
+                if (action == 1 && memory[i]->getPosition() > position) { index = i; break; }
+            }
+        } else index += action == 0 ? -1 : 1;
+        if (index < 0 || index >= memory.size()) return;
+        selected = memory[index];
+        { auto guard = lockMutex(&m_trackMutex); if (m_pLoadedTrack != track) return; m_rx3MemorySelected = selected; }
+        m_pPlay->set(0);
+        m_pCuePoint->set(selected->getPosition().toEngineSamplePos());
+        if (selected->getType() != mixxx::CueType::MemoryCue)
+            setLoop(selected->getPosition(), selected->getEndPosition(), false);
+        else emit loopRemove();
+        seekExact(selected->getPosition()); m_rx3MemoryIndex->set(index + 1);
+    } else if (action == 2) {
+        if (memory.size() >= 10) return;
+        auto start = getQuantizedCurrentPosition();
+        mixxx::audio::FramePos end;
+        auto type = mixxx::CueType::MemoryCue;
+        if (m_pLoopEnabled->toBool()) {
+            start = mixxx::audio::FramePos::fromEngineSamplePosMaybeInvalid(m_pLoopStartPosition->get());
+            end = mixxx::audio::FramePos::fromEngineSamplePosMaybeInvalid(m_pLoopEndPosition->get());
+            type = mixxx::CueType::MemoryLoop;
+        } else if (!m_pPlay->toBool()) {
+            const auto cue = mixxx::audio::FramePos::fromEngineSamplePosMaybeInvalid(m_pCuePoint->get());
+            if (cue.isValid()) start = cue;
+        }
+        for (const auto& cue : memory) if (cue->getPosition() == start && cue->getEndPosition() == end) return;
+        if (!start.isValid() || (end.isValid() && end <= start)) return;
+        auto added = track->createAndAddCue(type, Cue::kNoHotCue, start, end, mixxx::RgbColor(0xff8800));
+        { auto guard = lockMutex(&m_trackMutex); if (m_pLoadedTrack == track) m_rx3MemorySelected = added; }
+        loadCuesFromTrack();
+    } else if (action == 3 && selected) {
+        track->removeCue(selected);
+        { auto guard = lockMutex(&m_trackMutex); m_rx3MemorySelected.reset(); }
+        loadCuesFromTrack();
+    } else if (action == 4 && selected && selected->getType() != mixxx::CueType::MemoryCue) {
+        const bool active = selected->getType() != mixxx::CueType::ActiveLoop;
+        for (const auto& cue : memory) if (cue->getType() == mixxx::CueType::ActiveLoop)
+            cue->setType(mixxx::CueType::MemoryLoop);
+        selected->setType(active ? mixxx::CueType::ActiveLoop : mixxx::CueType::MemoryLoop);
+    }
+}
+
+void CueControl::prepareRx3ActiveLoop(mixxx::audio::FramePos position, double advanceFrames) {
+    const auto loop = m_rx3ActiveLoop.getValue();
+    if (!loop.startPosition.isValid() || !loop.endPosition.isValid()) return;
+    if (position < loop.startPosition) m_rx3ActiveLoopTriggered = false;
+    if (!m_rx3ActiveLoopTriggered && advanceFrames > 0 && position <= loop.startPosition &&
+            position + mixxx::audio::FrameDiff_t(advanceFrames) >= loop.startPosition &&
+            !m_pLoopEnabled->toBool()) {
+        m_rx3ActiveLoopTriggered = true;
+        setLoop(loop.startPosition, loop.endPosition, true);
+    }
+}
