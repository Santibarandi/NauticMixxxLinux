+bool LoopingControl::relocateLoopToHotcue(mixxx::audio::FramePos startPosition) {
+    const auto previous = m_loopInfo.getValue();
+    if (!m_bLoopingEnabled || !startPosition.isValid() ||
+            !previous.startPosition.isValid() || !previous.endPosition.isValid() ||
+            previous.endPosition <= previous.startPosition) {
+        return false;
+    }
+    auto endPosition = startPosition + (previous.endPosition - previous.startPosition);
+    // Preserve a beat loop's musical length even across a variable-tempo grid.
+    // Manually trimmed loops retain their exact sample duration.
+    const double beats = findBeatloopSizeForLoop(previous.startPosition, previous.endPosition);
+    if (m_pBeats && beats > 0) {
+        const auto beatEnd = m_pBeats->findNBeatsFromPosition(startPosition, beats);
+        if (beatEnd.isValid() && beatEnd > startPosition) {
+            endPosition = beatEnd;
+        }
+    }
+    setLoop(startPosition, endPosition, true);
+    return true;
+}
+
 void LoopingControl::setLoop(mixxx::audio::FramePos startPosition,
         mixxx::audio::FramePos endPosition,
         bool enabled) {
