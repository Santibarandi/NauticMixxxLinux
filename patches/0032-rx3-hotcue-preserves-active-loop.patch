+void CueControl::seekHotcue(mixxx::audio::FramePos position, bool exact) {
+    auto* engine = getEngineBuffer();
+    if (!engine || !position.isValid()) {
+        return;
+    }
+    if (m_pLoopEnabled->toBool()) {
+        // Loop relocation preserves phase through the normal quantized seek.
+        const auto target = quantizeCuePoint(position);
+        if (target.isValid()) {
+            engine->queueNewPlaypos(target, EngineBuffer::SEEK_HOTCUE);
+        }
+    } else if (exact) {
+        seekExact(position);
+    } else {
+        seekAbs(position);
+    }
+}
